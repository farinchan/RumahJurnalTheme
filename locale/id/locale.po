msgid "plugins.themes.rumahJurnal.name"
msgstr "Tema Rumah Jurnal"

msgid "plugins.themes.rumahJurnal.description"
msgstr "Tema portal modern khusus beranda indeks jurnal dengan Tailwind CSS, pencarian interaktif, dan tampilan elegan."

msgid "plugins.themes.rumahJurnal.portalTitle"
msgstr "Portal Rumah Jurnal"

msgid "plugins.themes.rumahJurnal.searchPlaceholder"
msgstr "Cari jurnal berdasarkan nama, fokus kajian, e-ISSN, atau kata kunci..."

msgid "plugins.themes.rumahJurnal.viewJournal"
msgstr "Kunjungi Jurnal"

msgid "plugins.themes.rumahJurnal.currentIssue"
msgstr "Terbitan Terkini"

msgid "plugins.themes.rumahJurnal.submitArticle"
msgstr "Kirim Naskah"

msgid "plugins.themes.rumahJurnal.option.primaryColor.label"
msgstr "Warna Primer (Primary Color)"

msgid "plugins.themes.rumahJurnal.option.primaryColor.description"
msgstr "Warna utama yang digunakan untuk bilah navigasi, judul, tombol utama, dan lencana (default: #2C366D)."

msgid "plugins.themes.rumahJurnal.option.secondaryColor.label"
msgstr "Warna Sekunder / Aksen (Secondary Color)"

msgid "plugins.themes.rumahJurnal.option.secondaryColor.description"
msgstr "Warna aksen/sorotan untuk efek hover, garis batas aktif, dan ikon sorotan (default: #D2AA2A)."

msgid "plugins.themes.rumahJurnal.option.heroTitle.label"
msgstr "Judul Utama Banner (Hero Title)"

msgid "plugins.themes.rumahJurnal.option.heroTitle.description"
msgstr "Judul headline utama yang ditampilkan di banner beranda portal (default: Portal Publikasi Ilmiah & Riset Terbuka)."

msgid "plugins.themes.rumahJurnal.option.heroDescription.label"
msgstr "Deskripsi Banner (Hero Description)"

msgid "plugins.themes.rumahJurnal.option.heroDescription.description"
msgstr "Teks deskripsi pengantar di bawah judul banner beranda portal."

msgid "plugins.themes.rumahJurnal.auth.loginSubtitle"
msgstr "Silakan masukkan nama pengguna atau email dan kata sandi Anda."

msgid "plugins.themes.rumahJurnal.auth.usernamePlaceholder"
msgstr "Nama pengguna atau alamat email..."

msgid "plugins.themes.rumahJurnal.auth.passwordPlaceholder"
msgstr "Masukkan kata sandi akun..."

msgid "plugins.themes.rumahJurnal.auth.hidePassword"
msgstr "Sembunyikan kata sandi"

msgid "plugins.themes.rumahJurnal.auth.showPassword"
msgstr "Tampilkan kata sandi"

